{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "forml": ["./src/index.ts"],
      "forml/types": ["./src/types.ts"],
      "forml/schema": ["./src/schema.ts"],
      "forml/autocomplete": ["./src/autocomplete.ts"]
    },
    "strict": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["vite/client"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "demo/**/*.ts",
    "demo/**/*.vue",
    ".storybook/**/*.ts",
    ".storybook/**/*.vue",
    "tests/**/*.ts",
    "vite.config.ts"
  ]
}
